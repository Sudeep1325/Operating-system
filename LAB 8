#include <stdio.h>

int main() {
    int n, i, indexBlock;
    int blocks[50];

    // Input phase
    printf("Enter number of blocks in the file: ");
    scanf("%d", &n);

    if(n > 50) {
        printf("Error: Maximum 50 blocks allowed.\n");
        return 1;
    }

    printf("Enter the index block: ");
    scanf("%d", &indexBlock);

    printf("Enter the block numbers allocated for the file:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &blocks[i]);
    }

    // Output phase
    printf("\nFile Allocation Table (Indexed Allocation):\n");
    printf("Index Block: %d\n", indexBlock);
    printf("---------------------------------\n");
    printf("Pointer No. | Block No.\n");
    printf("---------------------------------\n");

    for(i = 0; i < n; i++) {
        printf("%10d | %8d\n", i+1, blocks[i]);
    }

    printf("---------------------------------\n");

    return 0;
}
